+// lib/ui/line.ts
+// 선(테두리) 부품 — 2026-08-05 (47부 18차 · 대표님 지시)
+//
+// ══════════════════════════════════════════════════════════════════
+//  🔴 이 부품이 «왜» 생겼나
+//
+//   대표님 — 「이번 기획에 화면의 모든 라인들을 부품처럼 통일하면 어떤가」
+//            「모두 2.52:1로 통일하되, 부품을 만들 때는
+//              "외곽선 2.52:1" · "내부선 2.52:1" 을 ★각각 따로 조절하도록」
+//
+//   [무엇이 문제였나]  저장소 전체를 세어 보니 —
+//     · 테두리 지정 ★799 군데
+//     · 색이 드러난 것 374 군데인데 ★서로 다른 색이 «94 가지»
+//     · 변수에 숨은 것 약 200 군데 (LINE · C.line · line · C.border …)
+//     · 「내 이름 정밀분석」 ★한 화면 안에만 선이 «여섯 종류» 였습니다
+//   ⇒ 사람이 눈으로 맞출 수 있는 크기가 아닙니다. 한 곳에 모읍니다.
+//
+//  ⚠️⚠️ ★외곽선과 내부선을 «따로» 둔 까닭
+//     같은 색이라도 «얹히는 바탕» 이 다르면 대비가 갈립니다. 실측 —
+//       #ea8c46 on 흰 카드 #fff        2.52:1
+//       #ea8c46 on 카드   #FFFBF7      2.45:1
+//       #ea8c46 on 안쪽칸 #faf3ec      2.29:1
+//       #ea8c46 on 알약   #f2eee9      2.18:1
+//     ⇒ 내부선은 «더 어두운 바탕» 에 얹히므로 나중에 따로 올려야 할 수 있습니다.
+//     ⇒ 그때 ★INNER 만 바꾸면 됩니다. OUTER 는 안 건드려도 됩니다.
+//
+//  ⚠️ 45부에 확정된 두 단계와 «다른» 값입니다 —
+//       45부  바깥 #9c7a58 (3.93:1) · 안쪽 #b99a7d (2.63:1)
+//       47부  대표님이 ★2.52:1 하나로 통일하기로 정하셨습니다.
+//     ⇒ 45부 값은 ★다른 화면들에 «그대로 살아 있습니다». 함께 지우지 마십시오.
+//     ⇒ 넓히실 때는 ★화면 하나씩, 사진으로 확인받으며 옮기십시오.
+//
+//  ⛔ 여기 값을 바꾸면 ★이 부품을 쓰는 화면이 «전부» 바뀝니다.
+//     바꾸기 전에 «어느 화면들이 쓰는지» grep 으로 세십시오.
+// ══════════════════════════════════════════════════════════════════
+
+/** 카드·버튼의 «바깥» 선 — 흰 카드 위에서 2.52:1 */
+export const LINE_OUTER_COLOR = '#ea8c46'
+export const LINE_OUTER_WIDTH = '1px'
+
+/** 카드 «안» 의 작은 칸·알약 선 — 지금은 바깥과 같은 값 */
+export const LINE_INNER_COLOR = '#ea8c46'
+export const LINE_INNER_WIDTH = '1px'
+
+/** 바로 style 에 넣어 쓰는 꼴 */
+export const LINE_OUTER = `${LINE_OUTER_WIDTH} solid ${LINE_OUTER_COLOR}`
+export const LINE_INNER = `${LINE_INNER_WIDTH} solid ${LINE_INNER_COLOR}`
+
+/**
+ * ══════════════════════════════════════════════════════════════════
+ *  알약(칩) — ★«따로» 돌립니다  [대표님 지시]
+ *   「알약들만 모아서 따로 조절할 수 있게 할 수 있나」
+ *
+ *  [왜 따로 두나]  알약은 카드보다 «작고 촘촘해서» 선이 굵으면 답답해 보이고,
+ *    반대로 옅으면 «칸이 있는지» 안 보입니다. 카드와 «다른 눈금» 이 필요합니다.
+ *
+ *  [지금 값]  카드 내부선과 «같습니다». 나중에 갈라도 됩니다.
+ *  [실측]  #ea8c46 on 흰 알약  #ffffff  2.52:1
+ *          #ea8c46 on 흐린 알약 #f2eee9  ★2.18:1  ← 「피할 것」 처럼 muted 인 것
+ *    ⚠️ 흐린 알약이 가장 낮습니다. 올려야 하면 ★CHIP 만 바꾸십시오.
+ *
+ *  [높이]  padding 5px 10px · fontSize 11 · radius 14 → ★23.2px
+ *    ⚠️ 전에는 Chip 23.2px / ElChip 19.2px 로 ★4px 어긋나 있었습니다. 맞췄습니다.
+ *    ⛔ 둘 중 하나만 바꾸지 마십시오. 또 어긋납니다.
+ *
+ *  ⚠️ 알약은 «누르는 버튼이 아닙니다» — 보여 주기만 하므로
+ *     44px 최소선과 무관합니다. (46부 6-2 의 일주 알약과 같은 판단)
+ * ══════════════════════════════════════════════════════════════════
+ */
+export const CHIP_BORDER_COLOR = '#ea8c46'
+export const CHIP_BORDER_WIDTH = '1px'
+export const CHIP_BORDER = `${CHIP_BORDER_WIDTH} solid ${CHIP_BORDER_COLOR}`
+export const CHIP_RADIUS = 14
+export const CHIP_PADDING = '5px 10px'
+export const CHIP_FONT_SIZE = 11
+
+/**
+ * 경고·주의 선 — «뜻이 있는» 색이라 통일에서 뺍니다.
+ * 45부 8-2: 「빨강 선은 «주의» 뜻이라 ★갈색으로 안 바꿈」
+ */
+export const LINE_WARN_COLOR = '#c14545'
+export const LINE_WARN = `1px solid ${LINE_WARN_COLOR}`
+
+/**
+ * ⚠️ 이 부품을 «쓰지 않는» 자리 — 일부러 그대로 둡니다
+ *   · 사주명식(SajuWonguk) · 대운 · 세운 등 ★별도 부품  [대표님 지시]
+ *   · 인쇄물 넷 (CoupleCertificate · NamingCertificate · CareerCertificate · A4Print)
+ *     45부: 「★색 대비를 «올리지 마십시오». 잉크가 번집니다」
+ *   · 오행 색(木火土金水) 처럼 ★«뜻이 있는» 색
+ */
-- 
