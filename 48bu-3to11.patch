+    setLastKey(key)
+    if (checked) {
+      if (uid) load()
+      else setLoading(false)
+    }
+  }
+
+  async function load() {
+    // ⚠️ ★거르기는 RLS 가 합니다. 여기서 조건을 더 걸지 않습니다.
