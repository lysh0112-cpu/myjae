+  isOhaeng, OHAENG_ALL, type Ohaeng,
+} from './lib/saju/ohaeng'
+import {
+  buildSajuOhaengProfile, ensureProfile, judgeResource, relationDirected,
+  resourceFactsBlock, josa,
