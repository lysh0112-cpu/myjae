+head('⑧ 1단계 회귀 — 표준이 무너지지 않았는가')
+// ══════════════════════════════════════════════════════════════════
+{
+  // 옛 엔진(diagnoseName)이 정규화된 값으로 계속 정상 작동하는지
+  const mk = (raw: string): string => ohaengOrEmpty(raw)
