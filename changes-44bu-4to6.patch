+  check(!/'\/manseryeok\/naming\/diagnosis\/storage'/.test(diag),
+    `★다만 결과 화면이 옛 주소를 «가리키지» 않습니다`)
+}
+
+console.log('\n━━ ⑳-b ★하단 정돈 — 띠 배너 · A4 버튼 · 두 칸 ━━')
