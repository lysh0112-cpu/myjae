+            row.jobs?.length ? `【교재 직업】 ${row.jobs.join(' · ')}` : '',
+            row.keyword ? `【핵심어】 ${row.keyword}` : '',
+            row.social ? `【사회적 의미】 ${row.social}` : '',
+            ...orig(row),
