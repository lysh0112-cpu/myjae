+      }
+    }
+
+
+    {
+      const items: Item[] = []
+      const daySipsin = saju
+        .filter(s => s.stem && s.stem !== '?' && s.pillar !== '일주')
+        .map(s => `${s.pillar} ${s.stem} ${sipsinOf(dayStem, s.stem)}`)
+      if (daySipsin.length) {
+        items.push({
+          title: '원국 천간의 십신',
+          source: '일간 기준',
