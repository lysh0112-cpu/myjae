+//
+//  ⛔ ★관리자 화면·상담사 본인 화면에서는 쓰지 마십시오. 본명이 보여야 합니다.
+// ══════════════════════════════════════════════════════════════════
+export function shownName(c: { name?: string | null; alias?: string | null }): string {
+  const a = (c.alias ?? '').trim()
+  if (a) return a
+  return (c.name ?? '').trim()
+}
