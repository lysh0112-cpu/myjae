+-- ══════════════════════════════════════════════════════════════════
+--  _SQL_48bu_3차_상담사_전문분야_복수.sql
+--
+--  ★2026-08-06 (48부 3차) [대표님 지시]
+--    「전문분야를 홈서비스 버튼에 맞춰서 각 상담사별로
+--      토글로 연결할지 말지 버튼만 만들어 주면 된다」
+--
+--  ★무엇을 합니까
+--    consultants 에 ★specialties 칸을 «더합니다» (글줄 여러 개).
+--    담기는 값은 ★consult_prices 의 price_key 와 «같은» 값입니다 —
+--      mulsang · career · couple · saju · wedding
+--      · birth · moving · naming · naming_baby · tarot
+--
+--  ⚠️⚠️ ★기존 specialty 칸은 «그대로 둡니다». 지우지 마십시오.
+--     손님 화면(consultant-select)이 ★아직 이 칸을 읽습니다 —
+--     상담사 이름 아래 한 줄로 나옵니다.
+--     ⇒ 관리자에서 저장하면 두 칸이 «함께» 채워집니다.
+--
+--  ⚠️ 이 SQL 은 ★몇 번을 돌려도 됩니다 (IF NOT EXISTS).
+-- ══════════════════════════════════════════════════════════════════
+
+-- ① 전문분야 여러 개를 담을 칸
+ALTER TABLE consultants
+  ADD COLUMN IF NOT EXISTS specialties text[] NOT NULL DEFAULT '{}';
+
+COMMENT ON COLUMN consultants.specialties IS
+  '전문분야 (consult_prices.price_key 와 같은 값). 48부 3차. 빈 배열이면 아직 안 고른 것';
+
+-- ② 거를 때 빠르도록
+CREATE INDEX IF NOT EXISTS idx_consultants_specialties
+  ON consultants USING GIN (specialties);
+
+-- ══════════════════════════════════════════════════════════════════
+--  ⚠️ ★옛 전문분야 여덟은 «버리기로» 하셨습니다 [대표님 「버리고 새 열 개로 갈음」]
+--     사주·운명 / 궁합·연애 / 재물·사업 / 신살·대운
+--     / 개명·작명 / 타로·점술 / 풍수·이사 / 전반적 상담
+--
+--  ⇒ 지금 등록된 분들은 specialties 가 ★«빈 배열» 입니다.
+--     관리자 화면에서 상담사마다 토글을 켜 주십시오.
+--
+--  ⚠️ 옛 값이 궁금하시면 «지우기 전» 에 아래로 보실 수 있습니다.
+--     SELECT name, specialty FROM consultants ORDER BY sort;
+--
+--  ⛔ ★specialty 칸을 DROP 하지 마십시오. 손님 화면이 읽습니다.
+-- ══════════════════════════════════════════════════════════════════
+
+-- ③ 잘 들어갔는지 확인
+SELECT name, specialty, specialties
+FROM consultants
+ORDER BY sort, created_at;
