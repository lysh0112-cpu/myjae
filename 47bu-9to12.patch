@@ -0,0 +1,97 @@
+-- ════════════════════════════════════════════════════════════════════════
+-- 47부 2단계 — 전문가 상담 가격표를 «대표님 아홉» 으로 맞춥니다
+-- 2026-08-05
+--
+-- [지시]  「관리자 페이지 가격관리 전문가 상담가격의 이름(홈서비스순서와 일치)과
+--          토글버튼을 연결지어」
+--
+-- ★쓰는 법
+--   Supabase → SQL Editor 에 ★통째로 붙여넣고 한 번 실행하십시오.
+--   여러 번 돌려도 안전합니다.
+--
+-- ★한 줄도 «지우지» 않습니다. 45부 방식대로 «끄기» 만 합니다.
+-- ════════════════════════════════════════════════════════════════════════
+
+
+-- ── 0. 돌리기 «전» 모습을 남겨 둡니다 (되돌릴 때 씁니다) ────────────────
+select price_key, label, price, active, sort from consult_prices order by sort;
+--   ⚠️ ★이 결과를 «사진으로 찍어 두십시오». 되돌리실 때 쓰입니다.
+
+
+-- ── 1. 없는 줄 셋을 넣습니다 ────────────────────────────────────────────
+--   ★career · wedding · naming_baby 만 새로입니다.
+--     (moving 은 「이사택일 상담」으로 «이미» 있습니다)
+--   ⚠️ 값은 ★임시 50,000원 · ★꺼짐(false) 입니다.
+--      값을 정하신 뒤 관리자 화면에서 고치고 «켜십시오».
+insert into consult_prices (price_key, label, price, active, sort)
+values
+  ('career',      '진로적성',        50000, false, 2),
+  ('wedding',     '결혼택일',        50000, false, 5),
+  ('naming_baby', '내 아이 명품작명', 50000, false, 9)
+on conflict (price_key) do nothing;
+
+--   ⚠️ 위에서 「on conflict … 제약이 없다」는 오류가 나면 ★아래를 «먼저» 한 번 돌리십시오.
+--      alter table consult_prices add constraint consult_prices_price_key_key unique (price_key);
+--      (이미 있으면 「already exists」가 뜨는데 그냥 넘어가시면 됩니다)
+
+
+-- ── 2. 이름을 «홈 서비스 이름» 과 같게 하고, 차례를 대표님 아홉으로 ─────
+--   ★값(price)과 ★노출(active)은 «건드리지 않습니다». 지금 것을 그대로 둡니다.
+update consult_prices set label = '내 사주그림',      sort = 1 where price_key = 'mulsang';
+update consult_prices set label = '진로적성',          sort = 2 where price_key = 'career';
+update consult_prices set label = '궁합',              sort = 3 where price_key = 'couple';
+update consult_prices set label = '내 사주와 운세보기', sort = 4 where price_key = 'saju';
+update consult_prices set label = '결혼택일',          sort = 5 where price_key = 'wedding';
+update consult_prices set label = '출산택일',          sort = 6 where price_key = 'birth';
+update consult_prices set label = '이사택일',          sort = 7 where price_key = 'moving';
+update consult_prices set label = '내 이름 정밀분석',  sort = 8 where price_key = 'naming';
+update consult_prices set label = '내 아이 명품작명',  sort = 9 where price_key = 'naming_baby';
+
+--   ⚠️ 「내 이름 정밀분석」은 ★어른 개명과 «같은 것» 입니다 [대표님 확정].
+--      화면 둘이 이 한 줄을 씁니다 —
+--        naming/diagnosis            (이름 감정)
+--        naming/rename/newresult     (kind=개명)
+--   ⚠️ 「내 아이 명품작명」은 newresult 의 ★kind=신생아 일 때만 걸립니다.
+--   ⚠️ 홈 카드 이름은 「내 아이 명품작명」입니다. 대표님이 적으신 「내 아기 명품이름」과
+--      글자가 다릅니다. ★홈과 맞추려고 홈 이름을 썼습니다.
+--      바꾸시려면 위 label 만 고치면 됩니다. price_key 는 그대로 두십시오.
+
+
+-- ── 3. 아홉에 «없는» 줄은 끕니다 (지우지 않습니다) ──────────────────────
+--   ★prewedding(예비부부) 은 지금 «켜져» 있었습니다. 코드가 «전혀 안 부르는» 줄입니다.
+--   ★tarot 는 이번 아홉에서 빠졌습니다. 화면의 버튼도 걷어냈습니다.
+update consult_prices set active = false, sort = 90 where price_key = 'prewedding';
+update consult_prices set active = false, sort = 91 where price_key = 'married';
+update consult_prices set active = false, sort = 92 where price_key = 'tarot';
+--   ⛔ delete 하지 마십시오. 되살릴 때 관리자 화면에 「더하기」가 없어 또 SQL 이 필요합니다.
+
+
+-- ── 4. 돌린 «뒤» 를 확인합니다 ──────────────────────────────────────────
+select price_key, label, price, active, sort from consult_prices order by sort;
+--   ⇒ ★열두 줄이 나와야 합니다 (아홉 + 꺼둔 셋)
+--   ⇒ 위 아홉 줄의 차례가 대표님이 적으신 아홉과 «같아야» 합니다
+
+
+-- ════════════════════════════════════════════════════════════════════════
+-- 🔴 돌린 뒤 «관리자 화면에서» 하실 일
+--
+--   💰 가격 관리 → 「🔮 전문가 상담 가격」 표에서
+--     ① 아홉 줄의 ★값을 정하십시오
+--     ② 손님에게 보이실 것만 ★켜십시오
+--
+--   ⚠️⚠️ ★「이사택일」이 지금 ★0원 인데 «켜져» 있습니다.
+--      손님이 ★무료로 상담을 신청할 수 있는 상태로 보입니다.
+--      값을 넣으시거나, 값을 정할 때까지 ★꺼 두시기를 권합니다.
+--      (인수인계서 9-5 「이사택일 결제 관문이 없습니다」와 이어지는 자리입니다)
+--
+--   [지금 값 — 사진에서 읽은 것]
+--     내 사주그림        50,000  꺼짐
+--     진로적성           50,000  꺼짐   ← 새로 넣음
+--     궁합               50,000  켜짐
+--     내 사주와 운세보기  50,000  켜짐
+--     결혼택일           50,000  꺼짐   ← 새로 넣음
+--     출산택일           70,000  켜짐
+--     이사택일           ★0      ★켜짐  ← 확인이 필요합니다
+--     내 이름 정밀분석    80,000  꺼짐
+--     내 아이 명품작명    50,000  꺼짐   ← 새로 넣음
+-- ════════════════════════════════════════════════════════════════════════
-- 
2.43.0


