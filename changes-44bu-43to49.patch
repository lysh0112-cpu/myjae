+    lines.push('규칙을 따르는 것도, 스스로 정하는 것도 크게 어렵지 않은 편이에요. 자리에 따라 맞춰 갈 수 있는 결입니다.')
+  }
+
+  // ── 앞에 나서는 쪽인가 ──
+  if (bigyeop >= 25 && siksang >= 25) {
