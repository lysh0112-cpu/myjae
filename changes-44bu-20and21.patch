+  check(/보관함에 저장하지 못했어요/.test(diag),
+    `⚠️ 저장 «실패» 알림은 눈에 띄게 그대로입니다`)
+
+  // ② A4 버튼이 «컴팩트» 한가 (지시 ③)
+  const pad = (cert.match(/width: '100%', padding: '(\d+)px \d+px', borderRadius: 12/) ?? [])[1]
+  check(!!pad && Number(pad) <= 11,
