+  const bad: string[] = []
+  for (const f of files) {
+    const src = read(f)
+    for (const m of src.matchAll(/from '([^']+)'/g)) {
+      if (m[1].startsWith('/')) bad.push(`${f} → ${m[1]}`)
+    }
+  }
+  check(bad.length === 0,
