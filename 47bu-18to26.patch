@@ -0,0 +1,70 @@
+-- ════════════════════════════════════════════════════════════════════════
+-- 47부 26차 — 「예비부부 상담」·「부부 궁합 상담」 두 줄 지우기
+-- 2026-08-05  [대표님 지시]
+--   「예비부부상담과 부부 궁합 상담은 관리자 페이지에서 지워줘」
+--
+-- ★왜 SQL 인가
+--   관리자 화면(💰 가격 관리)의 PriceManager 는 ★update 만 합니다.
+--   insert 도 delete 도 «없습니다». 그래서 줄을 지우려면 SQL 이 필요합니다.
+--
+-- ★쓰는 법
+--   Supabase → SQL Editor 에 ★통째로 붙여넣고 한 번 실행하십시오.
+-- ════════════════════════════════════════════════════════════════════════
+
+
+-- ── 0. 지우기 «전» 을 남겨 둡니다 (되돌릴 때 씁니다) ────────────────────
+select price_key, label, price, active, sort from consult_prices order by sort;
+--   ⚠️ ★이 결과를 «사진으로 찍어 두십시오».
+
+
+-- ── 1. 두 줄 지우기 ────────────────────────────────────────────────────
+--   ⚠️⚠️ 지우기 전에 ★코드를 전수로 훑어 확인했습니다 —
+--      priceKey 로 prewedding · married 를 부르는 곳이 ★«한 곳도» 없습니다.
+--      ⇒ 손님 화면 어디에도 이 두 상담의 버튼이 «없었습니다».
+--        관리자 화면에서만 «열려 있는 것처럼» 보였습니다.
+--
+--   🔴🔴 ★헷갈리기 쉬운 것 — 같은 낱말이 «다른 뜻» 으로도 쓰입니다
+--      prewedding · married 는 ★«궁합 종류»(mode) 로도 쓰입니다 —
+--        consultant-select · SummaryBand · couple-storage · chat-stream
+--        · useDashboardTable
+--      ⇒ 그쪽은 ★«살아 있는 기능» 입니다. 코드를 지우지 마십시오.
+--      ⇒ 여기서 지우는 것은 ★consult_prices 표의 «가격 줄» 뿐입니다.
+delete from consult_prices where price_key in ('prewedding', 'married');
+
+
+-- ── 2. 지운 «뒤» 확인 ──────────────────────────────────────────────────
+select price_key, label, price, active, sort from consult_prices order by sort;
+--   ⇒ ★열 줄이 남아야 합니다 —
+--       1 mulsang      내 사주그림
+--       2 career       진로적성
+--       3 couple       궁합
+--       4 saju         내 사주와 운세보기
+--       5 wedding      결혼택일
+--       6 birth        출산택일
+--       7 moving       이사택일
+--       8 naming       내 이름 정밀분석
+--       9 naming_baby  내 아이 명품작명
+--      92 tarot        타로 상담      ← ★이제 «쓰입니다» (47부 26차)
+--
+--   ⚠️ tarot 의 sort 가 92 라 맨 아래에 있습니다. 아홉 뒤로 올리시려면 —
+--        update consult_prices set label = '타로', sort = 10 where price_key = 'tarot';
+
+
+-- ════════════════════════════════════════════════════════════════════════
+-- 🔴 ★타로 상담이 «살아났습니다» — 47부 26차
+--
+--   [대표님]  「타로 상담은 타로결과화면 맨하단 상담사 연결을 넣어줘…토글로 끄면 되니까」
+--
+--   ⇒ 타로 결과 화면 «맨 아래» 에 상담 카드를 넣었습니다.
+--      ★음악 크레디트 «위» 입니다 (크레디트는 맨 아래에 남아야 합니다 — CC BY 4.0).
+--   ⇒ 관리자 「💰 가격 관리 → 전문가 상담 가격」의 ★「타로 상담」 줄이 그대로 쓰입니다.
+--      ★지금 40,000원 · 켜짐. 값을 확인하시고 쓰십시오.
+--
+--   ⚠️⚠️ 타로는 관리자 화면 «두 곳» 에 나옵니다 —
+--      tarot_prices     타로 «뽑기» 값 · 무료 횟수
+--      consult_prices   ★타로 «상담» 값 (이번에 살린 것)
+--      ★둘은 «다른» 것입니다.
+--
+--   ⇒ ⚠️ 코드도 함께 올리셔야 합니다. zip 을 붙이고 push 하신 뒤에
+--        이 SQL 을 돌리시면 순서가 깔끔합니다. (반대로 하셔도 탈은 없습니다)
+-- ════════════════════════════════════════════════════════════════════════
