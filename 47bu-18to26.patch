           style={{
             width: '100%', marginBottom: 14, padding: '11px 12px', borderRadius: 12,
-            background: CARD, border: `1px solid ${LINE}`, color: '#6b5340',
+            background: CARD, border: LINE_OUTER, color: '#6b5340',
