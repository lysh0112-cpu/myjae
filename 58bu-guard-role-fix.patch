+// ----------------------------------------------------------------------------
+function roleReader() {
+  const key = process.env.SUPABASE_SERVICE_ROLE_KEY
+  if (!key) return null   // ★열쇠가 없으면 null — 부르는 쪽이 anon 으로 내려간다
+  return createClient(
+    process.env.NEXT_PUBLIC_SUPABASE_URL!,
+    key,
+    { auth: { autoRefreshToken: false, persistSession: false } },
+  )
+}
