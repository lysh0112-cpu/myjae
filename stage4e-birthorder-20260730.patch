+ */
+export interface SajuOhaengProfile {
+  yongsin: Ohaeng | null
+  heeksin?: Ohaeng | null
+  /** ★지금까지 naming 이 받지 않던 값 */
+  gisin?: Ohaeng | null
+  /** ★지금까지 naming 이 받지 않던 값 */
