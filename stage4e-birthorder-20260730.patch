+check(relationDirected('목', '토') === '순극', `목→토 = 순극`)
+check(relationDirected('토', '목') === '역극', `토→목 = 역극`)
+check(relationDirected('목', '목') === '비화', `목→목 = 비화`)
+check(relationDirected('목', '금') === '역극', `목→금 = 역극 (금剋목)`)
