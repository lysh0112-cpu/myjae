+// lib/saju/specialAvoidData.ts
+// 특수 피함 한자 자료 — 숫자 · 간지 · 동자이음 · 서열
+//
+// ══════════════════════════════════════════════════════════════════
+//  ⚠️⚠️ 이 파일의 글자는 «덕암 자료» 가 아닙니다. 성명학 통설을 우리가 옮긴 것입니다.
+//     (사주MBTI·목화통명과 같은 성격 — SOURCE_INDEX 에 넣지 않았습니다. 교훈 CD)
+//
+//  ★2026-07-30 실측 — 덕암 표 5,111행과 대조한 결과
+//
+//      숫자      28건 표에 있음
+//      간지      23건
+//      동자이음  13건
+//      서열      12건
+//      ─────────────────────────────────────────
+//      덕암이 «쓸 수 있다»(不用 아님) 고 본 것이  67건 / 4,164건 (1.6%)
+//        大吉 1 · 中吉 36 · 小吉 30
+//
+//    ⚠️ 즉 이 규칙은 **덕암 판정을 일부 뒤집습니다.**
+//       흔한 이름 글자가 여기 들어 있습니다 —
+//         辰(진) 中吉 · 丁(정) 中吉 · 寅(인) 中吉 · 元(원) 中吉 · 庚(경) 中吉
+//         申(신) 中吉 · 億(은) 小吉 · 亥(해) 小吉 · 酉(유) 小吉
+//       그래서 **막지 않고 «뒤로 미는» 작은 감점** 으로만 씁니다.
+//       ★연재쌤이 「이건 감점하지 말라」 하시면 아래 상수 하나로 끕니다.
+// ══════════════════════════════════════════════════════════════════
+
+/** 동자이음 — 한자: [읽히는 음들] */
+export const MULTI_SOUND_HANJA_MAP: Record<string, string[]> = {
+  樂: ['낙', '락', '악', '요'],
+  殺: ['살', '쇄'],
+  易: ['역', '이'],
+  車: ['차', '거'],
+  狀: ['상', '장'],
+  量: ['양', '량'],
+}
+
+/**
+ * 자녀 서열 한자 — 1:첫째 2:둘째 3:셋째 4:막내
+ *
+ * ⚠️⚠️ **지금은 걸리지 않습니다.** 이름 풀이 폼이 «몇째» 를 묻지 않기 때문입니다.
+ *    (checkSpecialAvoidRules 는 birthOrder 가 없으면 이 검사를 건너뜁니다)
