+      for (const ch of [p?.stem, p?.branch]) {
+        if (!ch) continue
+        const el = ohaengOfChar(ch)
+        if (el && (OHAENG_ALL as readonly string[]).includes(el)) count[el as Ohaeng] += 1
+      }
